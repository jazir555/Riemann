      _ = 11.55 := by norm_num
  have hF : ‖ZetaUpperR02ThreeLines.poleRemovedZeta s‖ ≤ (1 + |s.im|) * 2 := by
    have h1 : ‖ZetaUpperR02ThreeLines.poleRemovedZeta s‖ ≤ ‖s - 1‖ * 2 := by
