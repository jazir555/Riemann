    have ha3 : a * a ^ 2 = a ^ 3 := by ring
    have e : 27900 * ((a / 30) ^ 3) = 31 / 30 * a ^ 3 := by ring
    have e2 : (a + 1) * a ^ 2 = a ^ 3 + a ^ 2 := by ring
    linarith
