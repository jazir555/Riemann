  have hexp32_nn : (0 : ℝ) ≤ Real.exp (Kmid * ((9 : ℝ) ^ (3 / 2 : ℝ))) := Real.exp_nonneg _
  have hdamp_nn : (0 : ℝ) ≤ (2.7183 : ℝ) := by norm_num
  have hW1_nn : (0 : ℝ) ≤ 18 * Real.exp ((1 + Real.pi / 2) * 9) * 2.7183 :=
