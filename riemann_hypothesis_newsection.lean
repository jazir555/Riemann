    have hb : (0 : ℝ) ≤ 2 + |z.im| := by linarith
    exact mul_nonneg hb h2X
  calc ‖ZetaUpperR02ThreeLines.dampedPoleRemoved z‖
      ≤ Real.exp ((1 - (z.im + 6.75) ^ 2) / 100) *
        ((2 + |z.im|) * (2 * ((1 + |z.im| ^ 2) + (3.1416 * |z.im| / 2 + 1)))) := hG
