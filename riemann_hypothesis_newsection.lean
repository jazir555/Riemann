      calc (1 : ℝ) = (1 : ℝ) ^ 2 := by norm_num
        _ ≤ (z.im + 6.75) ^ 2 := pow_le_pow_left₀ (by norm_num) h1 2
    linarith
  have hcmp := exp28_le_exp100_of_nonpos hX
  have h100 : Real.exp ((1 - (z.im + 6.75) ^ 2) / 100) ≤ 0.1 := by
    have h := CIJointStirling.damp_pos_01 hz hpos
