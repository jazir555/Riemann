  have hle : (6.37 : ℝ) * Real.Gamma 6.37 ≤ 6.37 * 235.19 :=
    mul_le_mul_of_nonneg_left
      Door3GammaCut89.realGamma_637_le_improved (by norm_num)
  have hfin : (6.37 : ℝ) * 235.19 ≤ 1498.17 := by norm_num
