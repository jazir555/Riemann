    have h2 : (0 : ℝ) ≤ 3.1416 * |z.im| / 2 := by linarith
    have hX : (0 : ℝ) ≤ (1 + |z.im| ^ 2) + (3.1416 * |z.im| / 2 + 1) := by linarith
    have h2X : (0 : ℝ) ≤ 2 * ((1 + |z.im| ^ 2) + (3.1416 * |z.im| / 2 + 1)) := by
