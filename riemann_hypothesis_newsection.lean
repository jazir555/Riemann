/-- Parallel neg sup premise on `[10.6, 21]`: eleven-unit case split. -/
theorem DD_supNeg {a : ℝ} (hlo : (10.6 : ℝ) ≤ a) (hhi : a ≤ 21) :
    Real.exp ((1 - (a - 6.75) ^ 2) / 28) *
      (Real.sqrt (4 + a ^ 2) * (1.65 * ((1.26 / 19.5) * Real.sqrt (a ^ 3)))) ≤ 36 := by
