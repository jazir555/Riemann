/-- Parameterized six-shift drop core: `‖Γ z‖ ≤ G` from a shifted-numerator cap
`‖Γ (z+6)‖ ≤ N`, an explicit denominator floor `D0 ≤ D(z)`, and the cap
arithmetic `N ≤ G * D0`. Telescope mirrors
`Door3GammaCutR02.gamma_drop_of_shifted` read-only. -/
theorem gamma_drop_with_floor {z : ℂ} {N G D0 : ℝ}
    (hzre_lo : (0.025 : ℝ) ≤ z.re) (habs : (2.625 : ℝ) ≤ |z.im|)
    (hD_ge : D0 ≤ ‖z + ((5 : ℕ) : ℂ)‖
      * (‖z + ((4 : ℕ) : ℂ)‖
      * (‖z + ((3 : ℕ) : ℂ)‖
      * (‖z + ((2 : ℕ) : ℂ)‖ * (‖z + ((1 : ℕ) : ℂ)‖ * ‖z‖)))))
    (hD0pos : (0 : ℝ) < D0)
    (hGN : ‖Complex.Gamma (z + ((6 : ℕ) : ℂ))‖ ≤ N)
    (hG0 : 0 ≤ G) (hcap : N ≤ G * D0) :
    ‖Complex.Gamma z‖ ≤ G := by
  have hnez : z ≠ 0 := by
    intro hcon
    have hre := congrArg Complex.re hcon
