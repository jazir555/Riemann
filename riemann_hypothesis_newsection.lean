  intro y hy
  obtain ⟨s, hs, rfl⟩ := hy
  simp only [Function.comp_apply]
  obtain ⟨hs_strip, hs_win⟩ := hs
  simp only [Set.mem_setOf_eq] at hs_win
  have hmem : (-1 : ℝ) ≤ s.re ∧ s.re ≤ 2 := by
