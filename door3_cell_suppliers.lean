/-- `Re₈₇ ≥ -0.34` (`r₈₇ ≤ 0.34`, `-1 ≤ cos`; TRUE `≈ 0.17`). -/
theorem CS_Re87_ge_neg034 :
    (-0.34 : ℝ) ≤ (87 : ℝ) ^ (-(0.395 : ℝ)) * Real.cos (6.75 * Real.log 87) := by
  have hr0 : (0 : ℝ) ≤ (87 : ℝ) ^ (-(0.395 : ℝ)) :=
    le_of_lt (Real.rpow_pos_of_pos (by norm_num) _)
  have hru : (87 : ℝ) ^ (-(0.395 : ℝ)) ≤ (0.34 : ℝ) := CS_rpow87neg_upper_proved
  have hcos : (-1 : ℝ) ≤ Real.cos (6.75 * Real.log 87) := Real.neg_one_le_cos _
  have h1 : (87 : ℝ) ^ (-(0.395 : ℝ)) * (-1 : ℝ)
      ≤ (87 : ℝ) ^ (-(0.395 : ℝ)) * Real.cos (6.75 * Real.log 87) :=
    mul_le_mul_of_nonneg_left hcos hr0
  have h2 : (87 : ℝ) ^ (-(0.395 : ℝ)) * (-1 : ℝ) = -((87 : ℝ) ^ (-(0.395 : ℝ))) := by
    ring
  have h3 : (-0.34 : ℝ) ≤ -((87 : ℝ) ^ (-(0.395 : ℝ))) := by
    linarith [hru]
  linarith

