    (88 : ℝ) ^ (-(0.395 : ℝ)) * Real.cos (6.75 * Real.log 88) ≤ (0.34 : ℝ) := by
  have hr0 : (0 : ℝ) ≤ (88 : ℝ) ^ (-(0.395 : ℝ)) :=
