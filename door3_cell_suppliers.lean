  have hru : (65 : ℝ) ^ (-(0.395 : ℝ)) ≤ (0.34 : ℝ) := CS_rpow65neg_upper_proved
  have hsin : (-1 : ℝ) ≤ Real.sin (6.75 * Real.log 65) := by
