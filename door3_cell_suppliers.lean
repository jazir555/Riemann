theorem CS_cpow65_sCenter_im : ((((65 : ℝ)) : ℂ) ^ (-R02Pilot.sCenter)).im
    = (65 : ℝ) ^ (-(0.395 : ℝ)) * Real.sin (6.75 * Real.log 65) := by
  have h65pos : (0 : ℝ) < 65 := by norm_num
  have hxC : ((65 : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt h65pos)
  rw [Complex.cpow_def_of_ne_zero hxC]
  have hlog : Complex.log ((65 : ℝ) : ℂ) = (((Real.log 65 : ℝ)) : ℂ) :=
    (Complex.ofReal_log (le_of_lt h65pos)).symm
  rw [hlog]
  have hre_w : (-R02Pilot.sCenter).re = (-(0.395 : ℝ)) := by
    have e : (-R02Pilot.sCenter).re = -(R02Pilot.sCenter.re) := rfl
    rw [e, R02Pilot.sCenter_re]
  have him_w : (-R02Pilot.sCenter).im = (6.75 : ℝ) := by
    have e : (-R02Pilot.sCenter).im = -(R02Pilot.sCenter.im) := rfl
    rw [e, R02Pilot.sCenter_im]
    norm_num
  have hzre : ((((Real.log 65 : ℝ)) : ℂ)).re = Real.log 65 := Complex.ofReal_re _
  have hzim : ((((Real.log 65 : ℝ)) : ℂ)).im = 0 := Complex.ofReal_im _
  have harg_re : ((((Real.log 65 : ℝ)) : ℂ) * (-R02Pilot.sCenter)).re
      = Real.log 65 * (-(0.395 : ℝ)) := by
    rw [Complex.mul_re, hzre, hzim, hre_w]
    ring
  have harg_im : ((((Real.log 65 : ℝ)) : ℂ) * (-R02Pilot.sCenter)).im
      = Real.log 65 * (6.75 : ℝ) := by
    rw [Complex.mul_im, hzre, hzim, him_w]
    ring
  have hexp : Real.exp (Real.log 65 * (-(0.395 : ℝ)))
      = (65 : ℝ) ^ (-(0.395 : ℝ)) :=
    (Real.rpow_def_of_pos h65pos _).symm
  have hsin : Real.sin (Real.log 65 * (6.75 : ℝ))
      = Real.sin (6.75 * Real.log 65) := by
    rw [mul_comm]
  rw [Complex.exp_im, harg_re, harg_im, hexp, hsin]

