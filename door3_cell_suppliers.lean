  have h2 : (199 : ℝ) ^ (-(0.395 : ℝ)) * (-1 : ℝ) = -((199 : ℝ) ^ (-(0.395 : ℝ))) := by
    ring
  have h3 : (-0.34 : ℝ) ≤ -((199 : ℝ) ^ (-(0.395 : ℝ))) := by
