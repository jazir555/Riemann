  have hcos : Real.cos (6.75 * Real.log 88) ≤ (1 : ℝ) := Real.cos_le_one _
  have h1 : (88 : ℝ) ^ (-(0.395 : ℝ)) * Real.cos (6.75 * Real.log 88)
      ≤ (88 : ℝ) ^ (-(0.395 : ℝ)) * (1 : ℝ) :=
    mul_le_mul_of_nonneg_left hcos hr0
  have h2 : (88 : ℝ) ^ (-(0.395 : ℝ)) * (1 : ℝ) = (88 : ℝ) ^ (-(0.395 : ℝ)) := by
