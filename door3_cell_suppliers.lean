    linarith
  have h1 : (65 : ℝ) ^ (-(0.395 : ℝ)) * (-1 : ℝ)
      ≤ (65 : ℝ) ^ (-(0.395 : ℝ)) * Real.sin (6.75 * Real.log 65) :=
    mul_le_mul_of_nonneg_left hsin hr0
  have h2 : (65 : ℝ) ^ (-(0.395 : ℝ)) * (-1 : ℝ) = -((65 : ℝ) ^ (-(0.395 : ℝ))) := by
    ring
  have h3 : (-0.34 : ℝ) ≤ -((65 : ℝ) ^ (-(0.395 : ℝ))) := by
    linarith [hru]
  linarith

