def CS_rpow7pos_upper : Prop := (7 : ℝ) ^ ((0.395 : ℝ)) ≤ 2.28

/-- CLOSED: `7^0.395 ≤ 2.28` via `exp_bound'` n=4 at
`x = 0.395·log 7 ≤ 0.78851` (uses `CS_log_seven_le`). -/
