theorem CS_cpow5_sCenter_re : ((((5 : ℝ)) : ℂ) ^ (-R02Pilot.sCenter)).re
    = (5 : ℝ) ^ (-(0.395 : ℝ)) * Real.cos (6.75 * Real.log 5) := by
