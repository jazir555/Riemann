theorem CS_log_eightyseven_eq :
    Real.log 87 = Real.log 29 + Real.log 3 := by
  have h87 : (87 : ℝ) = 29 * 3 := by norm_num
  conv_lhs => rw [h87]
  rw [Real.log_mul (by norm_num) (by norm_num)]

/-- `log 87` lower (`4.3588 ≤ log 87` from `CS_log_twentynine_ge` +
`CS_log_three_ge`; `3.3059 + 1.0529 = 4.3588`). -/
theorem CS_log_eightyseven_ge : (4.3588 : ℝ) ≤ Real.log 87 := by
  rw [CS_log_eightyseven_eq]
  have h29 := CS_log_twentynine_ge
  have h3 := CS_log_three_ge
  have hcap : (4.3588 : ℝ) ≤ 3.3059 + 1.0529 := by norm_num
  linarith

