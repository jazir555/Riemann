/-- Cpow real-part split for `87^{-s}` at `sCenter` (token mirror of
`CS_cpow85_sCenter_re`). -/
theorem CS_cpow87_sCenter_re : ((((87 : ℝ)) : ℂ) ^ (-R02Pilot.sCenter)).re
    = (87 : ℝ) ^ (-(0.395 : ℝ)) * Real.cos (6.75 * Real.log 87) := by
  have h87pos : (0 : ℝ) < 87 := by norm_num
  have hxC : ((87 : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt h87pos)
  rw [Complex.cpow_def_of_ne_zero hxC]
  have hlog : Complex.log ((87 : ℝ) : ℂ) = (((Real.log 87 : ℝ)) : ℂ) :=
    (Complex.ofReal_log (le_of_lt h87pos)).symm
  rw [hlog]
  have hre_w : (-R02Pilot.sCenter).re = (-(0.395 : ℝ)) := by
    have e : (-R02Pilot.sCenter).re = -(R02Pilot.sCenter.re) := rfl
    rw [e, R02Pilot.sCenter_re]
  have him_w : (-R02Pilot.sCenter).im = (6.75 : ℝ) := by
    have e : (-R02Pilot.sCenter).im = -(R02Pilot.sCenter.im) := rfl
    rw [e, R02Pilot.sCenter_im]
    norm_num
  have hzre : ((((Real.log 87 : ℝ)) : ℂ)).re = Real.log 87 := Complex.ofReal_re _
  have hzim : ((((Real.log 87 : ℝ)) : ℂ)).im = 0 := Complex.ofReal_im _
  have harg_re : ((((Real.log 87 : ℝ)) : ℂ) * (-R02Pilot.sCenter)).re
      = Real.log 87 * (-(0.395 : ℝ)) := by
    rw [Complex.mul_re, hzre, hzim, hre_w]
    ring
  have harg_im : ((((Real.log 87 : ℝ)) : ℂ) * (-R02Pilot.sCenter)).im
      = Real.log 87 * (6.75 : ℝ) := by
    rw [Complex.mul_im, hzre, hzim, him_w]
    ring
  have hexp : Real.exp (Real.log 87 * (-(0.395 : ℝ)))
      = (87 : ℝ) ^ (-(0.395 : ℝ)) :=
    (Real.rpow_def_of_pos h87pos _).symm
  have hcos : Real.cos (Real.log 87 * (6.75 : ℝ))
      = Real.cos (6.75 * Real.log 87) := by
    rw [mul_comm]
  rw [Complex.exp_re, harg_re, harg_im, hexp, hcos]

