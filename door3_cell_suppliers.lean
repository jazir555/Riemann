/-- CLOSED: `87^0.395 ≥ 4.01` via quadratic lower at
`x = 0.395·log 87 > 1.7217` (uses `CS_log_eightyseven_ge`). -/
theorem CS_rpow87pos_lower_proved : CS_rpow87pos_lower := by
  show (4.01 : ℝ) ≤ (87 : ℝ) ^ ((0.395 : ℝ))
  have h87 : (4.3588 : ℝ) ≤ Real.log 87 := CS_log_eightyseven_ge
  have hx_lo : (1.7217 : ℝ) < 0.395 * Real.log 87 := by
    have hmul : (0.395 : ℝ) * 4.3588 ≤ 0.395 * Real.log 87 :=
      mul_le_mul_of_nonneg_left h87 (by norm_num)
    have hcap : (1.7217 : ℝ) < 0.395 * 4.3588 := by norm_num
    linarith
  set x : ℝ := 0.395 * Real.log 87 with hx_def
  have hx0 : (0 : ℝ) ≤ x := le_trans (by norm_num) hx_lo.le
  have hsq : (1.7217 : ℝ) ^ 2 ≤ x ^ 2 :=
    pow_le_pow_left₀ (by norm_num) hx_lo.le 2
  have hquad := Real.quadratic_le_exp_of_nonneg hx0
  have hbase : (4.01 : ℝ) ≤ 1 + 1.7217 + (1.7217 : ℝ) ^ 2 / 2 := by
    norm_num
  have hchain : (4.01 : ℝ) ≤ Real.exp x := by
    linarith [hquad, hsq, hx_lo, hbase]
  have hrpow : (87 : ℝ) ^ ((0.395 : ℝ)) = Real.exp x := by
    rw [Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 87)]
    congr 1
    rw [hx_def]
    ring
  rw [hrpow]
  exact hchain

