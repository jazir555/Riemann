    _root_.zeta_half_eq_eta_div_of_identity L hEta
  have hLle : L ≤ (0.6069 : ℝ) := eta_limit_upper_tight L hLreal
  have hGle : Real.Gamma (1/4 : ℝ) * Real.pi ^ (-(1/4) : ℝ) ≤ (2.72973 : ℝ) := by
    have h := Gammaℝ_half_re_upper_tight
