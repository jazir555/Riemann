theorem R00_eta_fifth_norm_le_one :
    ‖((((5 : ℕ) : ℂ) ^ sR00)⁻¹)‖ ≤ (1 : ℝ) := by
  have h5n : ((((5 : ℕ)) : ℂ)) = (5 : ℂ) := by norm_cast
