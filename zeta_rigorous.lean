  have hper : Real.cos (D3_phase 4 - 4 * Real.pi) = Real.cos (D3_phase 4) := by
    have e : (D3_phase 4 - 2 * Real.pi) - 2 * Real.pi =
        D3_phase 4 - 4 * Real.pi := by ring
