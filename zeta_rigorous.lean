    (1 / 5 : ℝ) ≤ ‖∑ k ∈ Finset.range 2, etaDirichletTerm zetaCellS0 k‖ := by
  rw [etaDirichlet_S0_two_eq]
  have hX := norm_etaDirichlet_S0_second_le
  have h := norm_add_le
    (1 - ((((2 : ℕ) : ℂ) ^ zetaCellS0)⁻¹))
    ((((2 : ℕ) : ℂ) ^ zetaCellS0)⁻¹)
