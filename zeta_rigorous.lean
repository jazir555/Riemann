    (∑ k ∈ Finset.range N, f k).im = ∑ k ∈ Finset.range N, (f k).im := by
  induction N with
  | zero => simp
  | succ n ih => rw [Finset.sum_range_succ, Finset.sum_range_succ, Complex.add_im, ih]

