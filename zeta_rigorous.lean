/-- (DZ-0) True-phase successive increment `δₙ = φ(n+1) - φ(n)`. -/
noncomputable def ZDelta (n : ℕ) : ℝ := ZPhi (n + 1) - ZPhi n

/-- (DZ-0) True-phase unit-modulus piece on the block. -/
