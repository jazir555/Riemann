  rw [eN, eD] at hA
  have hB : (16 : ℝ) * (2 * 16 + 2 * (∑ n ∈ Finset.range 16,
      DV_quad 0.7 0 (n + 1) * star (DV_quad 0.7 0 n)).re) ≤ 583.808 := by
    have h1 : (2 : ℝ) * 16 + 2 * (∑ n ∈ Finset.range 16,
