    have e : ((((16 : ℝ) ^ ((5 / 8 : ℝ)))) ^ ((8 : ℕ)) : ℝ)
        = (16 : ℝ) ^ ((5 : ℕ)) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 16)]
      rw [show (5 / 8 : ℝ) * (((8 : ℕ)) : ℝ) = (5 : ℝ) by norm_num]
      rw [show (5 : ℝ) = (((5 : ℕ)) : ℝ) by norm_num]
