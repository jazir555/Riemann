    linarith
  have hmono := monotoneOn_of_deriv_nonneg (convex_Ici 0) hcont hdiff hnn
  have h0x := hmono (Set.mem_Ici.mpr le_rfl) (Set.mem_Ici.mpr hx) hx
  have hf0 : (fun u : ℝ =>
      Real.sin u - (u - u ^ 3 / 6 + u ^ 5 / 120 - u ^ 7 / 5040)) 0 = 0 := by
