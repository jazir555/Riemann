  have h3 := Real.log_three_lt_d9
  have hsum : 2 * Real.log 2 + Real.log 3 < (2.4849066504 : ℝ) := by linarith
  have hmul := mul_lt_mul_of_pos_left hsum (by norm_num : (0 : ℝ) < 8.75)
  have hnum : 8.75 * 2.4849066504 ≤ (21.743 : ℝ) := by norm_num
