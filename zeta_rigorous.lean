theorem D3_log_fourteen_eq : Real.log 14 = Real.log 2 + Real.log 7 := by
  have h14 : (14 : ℝ) = 2 * 7 := by norm_num
  rw [h14, Real.log_mul (by norm_num) (by norm_num)]

