/-- Gamma upper at `1-s`, row 0.395: `‖Gamma(1-s)‖ ≤ 2` (`Re = 0.605`). -/
theorem RowFE_Gamma_one_sub_upper_0395 {s : ℂ} (hre : s.re = 0.395) :
    ‖Complex.Gamma (1 - s)‖ ≤ 2 := by
  have hre1 : (1 - s).re = (0.605 : ℝ) := by
