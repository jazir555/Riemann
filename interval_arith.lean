/-- Shift nonvanishing (`Re > 0` so `{NE} 0`). -/
theorem zUpR22_ne0 : (1 - sR22 / 2) ≠ 0 := by
  have hre : (1 - sR22 / 2).re = 0.9 := zUpR22_re
  intro h
  rw [h, Complex.zero_re] at hre
  norm_num at hre

