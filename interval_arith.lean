  have hfrac_le : Real.pi / (20128 * 0.026)
      ≤ Real.pi / (‖Complex.sin ((Real.pi : ℂ) * (R02GammaUpper.sR02 / 2))‖
        * ‖Complex.Gamma (1 - R02GammaUpper.sR02 / 2)‖) :=
