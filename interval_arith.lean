  have hre : (1 - sR32 / 2 + 2).re = 2.9475 := by
    simp only [Complex.add_re, zUpR32_re, Complex.re_ofNat]
    norm_num
  have him : (1 - sR32 / 2 + 2).im = 3.375 := by
