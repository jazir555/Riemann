    norm_num
  have hsq : (4.48 : ℝ) ^ 2 ≤ ‖1 - sR32 / 2 + 2‖ ^ 2 := by
    rw [Complex.sq_norm, Complex.normSq_apply, hre, him]
    norm_num
  calc (4.48 : ℝ) = Real.sqrt ((4.48 : ℝ) ^ 2) :=
        (Real.sqrt_sq (by norm_num)).symm
    _ ≤ Real.sqrt (‖1 - sR32 / 2 + 2‖ ^ 2) := Real.sqrt_le_sqrt hsq
